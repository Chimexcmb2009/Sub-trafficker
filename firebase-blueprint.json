{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User account profile and balances",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "profilePic": { "type": "string" },
        "cashBalance": { "type": "number" },
        "accumulatedTrafficCash": { "type": "number" },
        "totalDataStreamedMB": { "type": "number" },
        "isp": { "type": "string", "enum": ["MTN", "Airtel", "Glo", "9mobile"] },
        "bankName": { "type": "string" },
        "accountNumber": { "type": "string" },
        "accountName": { "type": "string" },
        "biometrics": {
          "type": "object",
          "properties": {
            "face": { "type": "boolean" },
            "fingerprint": { "type": "boolean" },
            "passkey": { "type": "boolean" }
          }
        }
      },
      "required": ["uid", "email"]
    },
    "Transaction": {
      "title": "Transaction Log",
      "description": "Log of airtime conversions and withdrawals",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "type": { "type": "string", "enum": ["airtime_convert", "withdrawal", "traffic_cashout"] },
        "amount": { "type": "number" },
        "receivedAmount": { "type": "number" },
        "networkOrIsp": { "type": "string" },
        "referenceDetails": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "completed", "failed"] },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "userId", "type", "amount", "status", "timestamp"]
    },
    "FriendRequest": {
      "title": "Friend Request",
      "description": "Pending, accepted or rejected friend requests",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "fromUserId": { "type": "string" },
        "fromUserName": { "type": "string" },
        "fromUserPic": { "type": "string" },
        "toUserId": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "accepted", "rejected"] },
        "timestamp": { "type": "number" }
      },
      "required": ["id", "fromUserId", "toUserId", "status", "timestamp"]
    },
    "Friendship": {
      "title": "Friendship",
      "description": "Active friendship relationship between two users",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userA": { "type": "string" },
        "userB": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "userA", "userB", "createdAt"]
    },
    "ChatMessage": {
      "title": "Chat Message",
      "description": "Message in direct chat or community channel",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "text": { "type": "string" },
        "timestamp": { "type": "number" }
      },
      "required": ["id", "senderId", "text", "timestamp"]
    },
    "GameRoom": {
      "title": "Game Room",
      "description": "Active multiplayer game room",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "gameType": { "type": "string" },
        "hostId": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "hostId", "status"]
    },
    "GameInvite": {
      "title": "Game Invite",
      "description": "Invitation to join a game room",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "roomId": { "type": "string" },
        "fromUserId": { "type": "string" },
        "toUserId": { "type": "string" },
        "status": { "type": "string" },
        "timestamp": { "type": "number" }
      },
      "required": ["id", "roomId", "fromUserId", "toUserId", "status"]
    },
    "AdminSetting": {
      "title": "Admin Setting",
      "description": "Platform global configuration and ledgers",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "totalAdRevenue": { "type": "number" },
        "totalConversions": { "type": "number" }
      }
    },
    "FpsProfile": {
      "title": "FPS Profile",
      "description": "Player profile, loadouts, skins and stats for Blood Strike FPS",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "username": { "type": "string" },
        "level": { "type": "number" },
        "xp": { "type": "number" },
        "kills": { "type": "number" },
        "deaths": { "type": "number" },
        "headshots": { "type": "number" },
        "matchesPlayed": { "type": "number" },
        "matchesWon": { "type": "number" },
        "credits": { "type": "number" },
        "equippedCharacterId": { "type": "string" },
        "equippedWeaponId": { "type": "string" },
        "equippedSkin": { "type": "string" },
        "unlockedWeapons": { "type": "array" },
        "unlockedCharacters": { "type": "array" }
      },
      "required": ["uid"]
    },
    "FpsMatchmaking": {
      "title": "FPS Matchmaking",
      "description": "FPS matchmaking queue entry for Blood Strike",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "username": { "type": "string" },
        "mode": { "type": "string" },
        "timestamp": { "type": "number" }
      },
      "required": ["userId", "timestamp"]
    },
    "FpsMatch": {
      "title": "FPS Match Session",
      "description": "Live 3D multiplayer match session",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "hostUid": { "type": "string" },
        "mapId": { "type": "string" },
        "mode": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "hostUid", "mapId", "status"]
    },
    "FpsLivePlayer": {
      "title": "FPS Live Player State",
      "description": "Real-time 3D multiplayer player state",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" },
        "yaw": { "type": "number" },
        "pitch": { "type": "number" },
        "health": { "type": "number" },
        "shield": { "type": "number" },
        "action": { "type": "string" },
        "weaponId": { "type": "string" },
        "characterId": { "type": "string" },
        "kills": { "type": "number" },
        "isFiring": { "type": "boolean" },
        "updatedAt": { "type": "number" }
      },
      "required": ["uid", "name", "x", "y", "z", "health"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "User profile settings and balances"
    },
    "transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "List of all financial transactions"
    },
    "friend_requests/{requestId}": {
      "schema": "FriendRequest",
      "description": "Friend request invitations"
    },
    "friendships/{friendshipId}": {
      "schema": "Friendship",
      "description": "Friendship pairs between users"
    },
    "chats/{chatId}/messages/{messageId}": {
      "schema": "ChatMessage",
      "description": "Direct chat messages"
    },
    "community_chats/{channelId}/messages/{messageId}": {
      "schema": "ChatMessage",
      "description": "Community channel messages"
    },
    "game_rooms/{roomId}": {
      "schema": "GameRoom",
      "description": "Active multiplayer game rooms"
    },
    "game_invites/{inviteId}": {
      "schema": "GameInvite",
      "description": "Invitations to multiplayer game rooms"
    },
    "admin_settings/{settingId}": {
      "schema": "AdminSetting",
      "description": "Admin platform settings"
    },
    "fps_profiles/{userId}": {
      "schema": "FpsProfile",
      "description": "FPS game player stats, loadout and inventory"
    },
    "fps_matchmaking/{matchId}": {
      "schema": "FpsMatchmaking",
      "description": "FPS matchmaking queue"
    },
    "fps_matches/{matchId}": {
      "schema": "FpsMatch",
      "description": "Active 3D FPS multiplayer match"
    },
    "fps_matches/{matchId}/players/{playerId}": {
      "schema": "FpsLivePlayer",
      "description": "Real-time 3D multiplayer player state"
    }
  }
}
