{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Private user account profile, balances, and verification metadata",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "profilePic": { "type": "string" },
        "cashBalance": { "type": "number" },
        "airtimeBalance": { "type": "number" },
        "accumulatedTrafficCash": { "type": "number" },
        "totalDataStreamedMB": { "type": "number" },
        "isp": { "type": "string", "enum": ["MTN", "Airtel", "Glo", "9mobile"] },
        "bankDetails": { "type": "object" },
        "biometrics": { "type": "object" },
        "emailVerified": { "type": "boolean" },
        "phoneVerified": { "type": "boolean" },
        "faceStatus": { "type": "string", "enum": ["pending", "processing", "verified", "failed", "retry_required"] },
        "bankVerified": { "type": "boolean" }
      },
      "required": ["uid", "email"]
    },
    "PublicUser": {
      "title": "Public User Directory Profile",
      "description": "Non-sensitive public profile fields for friends, chat, and FPS matchmaking",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "username": { "type": "string" },
        "profilePic": { "type": "string" },
        "bio": { "type": "string" },
        "status": { "type": "string" },
        "isOnline": { "type": "boolean" },
        "lastSeen": { "type": "string" },
        "showOnlineStatus": { "type": "boolean" }
      },
      "required": ["uid", "name"]
    },
    "Transaction": {
      "title": "Transaction Log",
      "description": "Log of airtime conversions, sponsored reward claims, and withdrawals",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "type": { "type": "string", "enum": ["airtime_convert", "withdrawal", "traffic_cashout"] },
        "amount": { "type": "number" },
        "receivedAmount": { "type": "number" },
        "networkOrIsp": { "type": "string" },
        "referenceDetails": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "completed", "failed"] },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "userId", "type", "amount", "status", "timestamp"]
    },
    "FriendRequest": {
      "title": "Friend Request",
      "description": "Pending, accepted or declined friend requests",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "senderUid": { "type": "string" },
        "receiverUid": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "accepted", "declined"] },
        "createdAt": { "type": "string" }
      },
      "required": ["senderUid", "receiverUid", "status"]
    },
    "Friendship": {
      "title": "Friendship",
      "description": "Active friendship relationship between two users",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userA": { "type": "string" },
        "userB": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["userA", "userB"]
    },
    "ChatMessage": {
      "title": "Chat Message",
      "description": "Message in direct chat or community channel",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "chatId": { "type": "string" },
        "senderUid": { "type": "string" },
        "senderName": { "type": "string" },
        "content": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["senderUid", "content", "timestamp"]
    },
    "GameRoom": {
      "title": "Game Room",
      "description": "Active multiplayer game room",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "gameType": { "type": "string" },
        "hostUid": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["hostUid", "status"]
    },
    "GameInvite": {
      "title": "Game Invite",
      "description": "Invitation to join a game room",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "roomId": { "type": "string" },
        "fromUid": { "type": "string" },
        "toUid": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["roomId", "fromUid", "toUid", "status"]
    },
    "AdminSetting": {
      "title": "Admin Setting",
      "description": "Platform global configuration and revenue ledger",
      "type": "object",
      "properties": {
        "totalAdRevenue": { "type": "number" },
        "totalConversions": { "type": "number" }
      }
    },
    "FpsProfile": {
      "title": "FPS Profile",
      "description": "Player profile, loadouts, skins and stats for Blood Strike FPS",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "username": { "type": "string" },
        "level": { "type": "number" },
        "xp": { "type": "number" },
        "kills": { "type": "number" },
        "deaths": { "type": "number" }
      },
      "required": ["uid"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "Owner-only user profile settings and balances"
    },
    "users_public/{userId}": {
      "schema": "PublicUser",
      "description": "Public directory fields for chat, friends, and gaming"
    },
    "transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "User financial and conversion transactions"
    },
    "friend_requests/{requestId}": {
      "schema": "FriendRequest",
      "description": "Friend request invitations"
    },
    "friendships/{friendshipId}": {
      "schema": "Friendship",
      "description": "Friendship pairs between users"
    },
    "chats/{chatId}/messages/{messageId}": {
      "schema": "ChatMessage",
      "description": "Direct chat messages"
    },
    "community_chats/{channelId}/messages/{messageId}": {
      "schema": "ChatMessage",
      "description": "Community channel messages"
    },
    "game_rooms/{roomId}": {
      "schema": "GameRoom",
      "description": "Active multiplayer game rooms"
    },
    "game_invites/{inviteId}": {
      "schema": "GameInvite",
      "description": "Invitations to multiplayer game rooms"
    },
    "admin_settings/{settingId}": {
      "schema": "AdminSetting",
      "description": "Owner-only admin platform settings"
    },
    "fps_profiles/{userId}": {
      "schema": "FpsProfile",
      "description": "FPS game player stats, loadout and inventory"
    }
  }
}
